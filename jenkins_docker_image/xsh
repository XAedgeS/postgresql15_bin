                                             ? _generic_isCC(c, classnum)   \
                                             : above_latin1(c))
#define _generic_invlist_uvchr(classnum, c) ((c) < 256                        \
                                             ? _generic_isCC(c, classnum)   \
                                             : _is_uni_FOO(classnum, c))
